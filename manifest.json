{
  "id": "self-release",
  "name": "Skill 自更新与发布",
  "version": "1.3.1",
  "description": "当用户说「更新这个 skill / 发布这个 skill / 升级脚本到 GitHub / 打个 tag 推上去」时使用。自动定位目标 skill 对应的 GitHub 仓库、当前版本、最近 tag 与本地分支状态，然后按标准流程完成：版本递增（同步 SKILL.md + manifest.json + CHANGELOG.md）→ 本地验证 → 本地与仓库 clone 一致性比对 → 提交推送（署名白澤 程）→ 打 tag → 汇报。核心能力：发布过的 skill 自带 .release.json 坐标，任何机器装上后说一句话就能更新，不需要用户提供仓库地址或版本号。",
  "author": "白澤 程",
  "license": "MIT",
  "main": "./SKILL.md",
  "repository": "https://github.com/wpc6666/self-release",
  "homepage": "https://github.com/wpc6666/self-release",
  "install": {
    "type": "curl",
    "target": "~/.dsh/skills/self-release",
    "command": "curl -fsSL https://raw.githubusercontent.com/wpc6666/self-release/main/install.sh | bash",
    "alt_command": "git clone https://github.com/wpc6666/self-release.git ~/.dsh/skills/self-release"
  },
  "tags": [
    "skill",
    "release",
    "git",
    "automation",
    "版本管理"
  ],
  "keywords": [
    "skill 更新",
    "发布",
    "打 tag",
    "版本递增",
    "GitHub 推送"
  ],
  "update_mode": "overwrite",
  "min_agent_version": "1.0.0",
  "files": [
    "SKILL.md",
    "README.md",
    "manifest.json",
    "CHANGELOG.md",
    "scripts/release.py",
    "install.sh",
    "index.html"
  ]
}
