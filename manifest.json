{
  "id": "self-release",
  "name": "Skill 自更新与发布",
  "version": "1.7.0",
  "description": "当用户说「更新这个 skill / 发布这个 skill / 上架 / 上线 / 打个 tag 推上去」时使用。自动定位 GitHub 仓库、当前版本与分支，完成版本递增（三处元数据同步）→ 验证 → 提交推送 → 打 tag；也支持一键上架：建公开仓库 → 开 GitHub Pages → 生成手机适配的说明页 → 写入 About → 自动在主页加卡片。按 skill 自带坐标一键安装/更新，无需用户提供仓库地址或版本号。",
  "author": "白澤 程",
  "license": "MIT",
  "main": "./SKILL.md",
  "repository": "https://github.com/wpc6666/self-release",
  "homepage": "https://github.com/wpc6666/self-release",
  "install": {
    "type": "curl",
    "target": "~/.dsh/skills/self-release",
    "command": "curl -fsSL https://raw.githubusercontent.com/wpc6666/self-release/main/install.sh | bash",
    "alt_command": "git clone https://github.com/wpc6666/self-release.git ~/.dsh/skills/self-release"
  },
  "tags": [
    "skill",
    "release",
    "git",
    "automation",
    "版本管理",
    "github-pages",
    "publish",
    "cli",
    "one-liner"
  ],
  "keywords": [
    "skill 更新",
    "发布",
    "打 tag",
    "版本递增",
    "GitHub 推送",
    "一键上架",
    "自动建仓库",
    "自动开 Pages"
  ],
  "update_mode": "overwrite",
  "min_agent_version": "1.0.0",
  "files": [
    "SKILL.md",
    "README.md",
    "manifest.json",
    "CHANGELOG.md",
    "scripts/release.py",
    "install.sh",
    "index.html",
    "scripts/new_repo.py",
    "templates/page.html",
    "skill"
  ]
}
